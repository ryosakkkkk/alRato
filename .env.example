# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
# .env.local is git-ignored. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). Site key from reCAPTCHA Enterprise.
VITE_RECAPTCHA_ENTERPRISE_KEY=

# Local development only: an App Check debug token registered in the Firebase console.
# Leave empty to let the SDK print a new one in the browser console.
VITE_APPCHECK_DEBUG_TOKEN=
